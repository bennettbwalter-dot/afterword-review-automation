# Local-only fallback. Production must use all four separate least-privilege URLs below.
NODE_ENV=development
DATABASE_URL=postgresql://afterword_local:change-me@127.0.0.1:5432/afterword
AUTH_DATABASE_URL=postgresql://afterword_auth_login:change-me@127.0.0.1:5432/afterword
RUNTIME_DATABASE_URL=postgresql://afterword_runtime_login:change-me@127.0.0.1:5432/afterword
INGRESS_DATABASE_URL=postgresql://afterword_ingress_login:change-me@127.0.0.1:5432/afterword
WORKER_DATABASE_URL=postgresql://afterword_worker_login:change-me@127.0.0.1:5432/afterword
# Migration-only credential. Never expose it to the API or worker process.
MIGRATION_DATABASE_URL=postgresql://afterword_dba:change-me@127.0.0.1:5432/afterword
DATABASE_SSL=disable

APP_ORIGIN=http://127.0.0.1:4173
API_HOST=127.0.0.1
API_PORT=4174
INGRESS_HOST=127.0.0.1
INGRESS_PORT=4175
# Set to 1 only behind one trusted reverse proxy with direct origin access blocked.
TRUST_PROXY_HOPS=0
EXTERNAL_WEBHOOK_BASE_URL=https://api.example.com
PUBLIC_REVIEW_BASE_URL=https://reviews.example.com
# Build-time origin embedded in QR artwork; keep it on an owned permanent domain.
VITE_PUBLIC_REVIEW_BASE_URL=https://reviews.example.com
SESSION_COOKIE_NAME=afterword_session
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4174/api/v1/integrations/google/oauth/callback
# Must exactly match the authenticated Pub/Sub push endpoint.
GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google-business-profile/reviews
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=afterword-pubsub@example-project.iam.gserviceaccount.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_ASM_GROUP_ID=
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=

# One-time db:bootstrap inputs.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_DISPLAY_NAME=Business Owner
BOOTSTRAP_AGENCY_NAME=Managed Accounts
BOOTSTRAP_BUSINESS_NAME=Pilot Business
BOOTSTRAP_LOCATION_NAME=Main Location
BOOTSTRAP_TIMEZONE=Europe/London
BOOTSTRAP_COUNTRY=GB
