{
  "name": "review-anchor-staging-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/app", "/app/*", "/workspace", "/workspace/*"]
  },
  "vars": {
    "NODE_ENV": "production",
    "STRIPE_CHECKOUT_ENABLED": "false",
    "STRIPE_MODE": "test",
    "PROVIDER_DELIVERY_ENABLED": "false"
  }
}
