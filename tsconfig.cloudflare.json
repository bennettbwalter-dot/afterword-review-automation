{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["cloudflare/**/*.ts", "cloudflare/**/worker-configuration.d.ts"]
}
