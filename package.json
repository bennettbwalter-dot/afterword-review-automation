{
  "name": "review-anchor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ingress,web -c magenta,yellow,cyan \"npm:dev:api\" \"npm:dev:ingress\" \"npm:dev:web\"",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 4173",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "dev:api": "tsx watch server/index.ts",
    "dev:ingress": "tsx watch server/ingress.ts",
    "start:api": "tsx server/index.ts",
    "start:ingress": "tsx server/ingress.ts",
    "start:worker": "tsx server/worker.ts",
    "worker": "tsx server/worker.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "build:demo": "tsc -b && tsc -p tsconfig.server.json && vite build --mode cloudflare-demo",
    "deploy:demo": "npm run build:demo && npx --yes wrangler pages deploy dist --project-name review-anchor-demo --branch demo",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "typecheck:cloudflare": "tsc -p tsconfig.cloudflare.json --noEmit && tsc -p tests/cloudflare/tsconfig.json --noEmit",
    "cf:types": "wrangler types cloudflare/application/worker-configuration.d.ts --config cloudflare/application/wrangler.jsonc && wrangler types cloudflare/ingress/worker-configuration.d.ts --config cloudflare/ingress/wrangler.jsonc && wrangler types cloudflare/jobs/worker-configuration.d.ts --config cloudflare/jobs/wrangler.jsonc && wrangler types cloudflare/compat/worker-configuration.d.ts --config cloudflare/compat/wrangler.jsonc",
    "cf:dry-run": "wrangler deploy --dry-run --strict --config cloudflare/application/wrangler.jsonc && wrangler deploy --dry-run --strict --config cloudflare/ingress/wrangler.jsonc && wrangler deploy --dry-run --strict --config cloudflare/jobs/wrangler.jsonc && wrangler deploy --dry-run --strict --config cloudflare/compat/wrangler.jsonc",
    "cf:compat": "tsx scripts/cloudflare/verify-compat.ts",
    "test:security": "node --import tsx --test tests/platform-security.test.ts tests/backend-security.test.ts",
    "check": "npm run security:secrets && npm run typecheck && npm run test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:migrator": "tsx scripts/test-migrator.ts",
    "db:test:concurrency": "tsx scripts/test-database-concurrency.ts",
    "db:prepare:supabase": "tsx scripts/prepare-supabase.ts",
    "db:provision": "tsx scripts/provision-database.ts",
    "db:test:isolation": "tsx scripts/test-database-isolation.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "verify:journeys": "tsx scripts/verify-journeys.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/cli": "^0.1.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.112.0"
  }
}
